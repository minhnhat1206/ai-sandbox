# ---- AI provider -----------------------------------------------------------
# "mock"      : runs with zero keys, deterministic demo output (default)
# "anthropic" : real Claude via the Anthropic SDK, billed to YOUR key/credits
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model used for every sandbox run. Default is the current Opus.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (sandbox default: medium)
ANTHROPIC_EFFORT=medium

# ---- Admin console -----------------------------------------------------------
# Password for /admin. Change this before sharing any sandbox link.
ADMIN_TOKEN=change-me

# ---- Branding ------------------------------------------------------------------
VITE_BRAND_NAME=Your Company
VITE_BRAND_TAGLINE_VI=Học AI. Xây AI. Đo kết quả.
VITE_BRAND_TAGLINE_EN=Learn it. Build it. Measure it.
VITE_CONTACT_EMAIL=hello@example.com

# ---- Storage -------------------------------------------------------------------
# JSON file store (created on first run). Override for tests/deploys.
DATA_DIR=./data
PORT=3000
