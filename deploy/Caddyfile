# Caddy obtains and renews the HTTPS certificate automatically.
# Replace the domain, point its DNS A record at the server, then: sudo systemctl reload caddy
sandbox.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# SSE runs stream for minutes: do not buffer them.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}
}
